<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Back Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/backBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_revert"
        app:backgroundTint="@color/white"
        app:fabSize="mini" />

    <!-- Center Pin Marker -->
    <ImageView
        android:id="@+id/centerPin"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerInParent="true"
        android:layout_marginBottom="20dp"
        android:src="@android:drawable/ic_menu_mylocation"
        app:tint="@color/primary_green" />

    <!-- My Location Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/recenterBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/confirmLocationCard"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_mylocation"
        app:backgroundTint="@color/white"
        app:fabSize="mini" />

    <!-- Address Card at Bottom -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/confirmLocationCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select delivery location"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/currentAddressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fetching address..."
                android:layout_marginTop="8dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/confirmLocationBtn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Confirm Location"
                android:backgroundTint="@color/primary_green" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>
