<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background_light">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delivery Details"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/primary_dark_green"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/deliveryIdTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delivery #D123"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/statusTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Assigned"
                android:textSize="18sp"
                android:textColor="@color/accent_orange"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/farmerAddressTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pickup: Farmer Address"
                android:textSize="16sp"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/navigateFarmerButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Navigate to Pickup"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:drawableStart="@android:drawable/ic_menu_directions"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/customerAddressTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deliver to: Customer Address"
                android:textSize="16sp"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/navigateCustomerButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Navigate to Customer"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:drawableStart="@android:drawable/ic_menu_directions"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/primary_light_green"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Update Status"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/pickedUpButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mark Picked Up"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/onTheWayButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mark On The Way"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/deliveredButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mark Delivered"
                android:backgroundTint="@color/primary_green" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
